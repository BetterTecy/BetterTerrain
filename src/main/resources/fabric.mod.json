{
  "schemaVersion": 1,
  "id": "betterterrain",
  "version": "${version}",
  "name": "BetterTerrain",
  "description": "Long mountain ranges for Minecraft 26.3.",
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.betterterrain.BetterTerrain"],
    "client": ["dev.betterterrain.client.BetterTerrainClient"],
    "fabric-datagen": ["dev.betterterrain.datagen.BetterTerrainDataGenerator"]
  },
  "mixins": [
    "betterterrain.mixins.json",
    {"config": "betterterrain.client.mixins.json", "environment": "client"}
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": ">=0.166.2+26.3"
  }
}
